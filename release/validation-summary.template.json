    {
      "id": "reproducibility",
      "command": "KAREL_RELEASE_OUTPUT_DIR=<fresh-output> KAREL_RELEASE_WEB_IDE_CANDIDATE_STATE=<web-candidate-state> KAREL_RELEASE_WEB_IDE_TARBALL=<web-candidate> npm run release:candidate",
