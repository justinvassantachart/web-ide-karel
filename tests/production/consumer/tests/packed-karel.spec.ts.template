} from './helpers'

const test = base.extend({
  context: async ({
    playwright,
    browserName,
    contextOptions: browserContextOptions,
  }, use) => {
    const browserType = playwright[browserName]
    const browser = await browserType.launch()
    try {
      const context = await browser.newContext(browserContextOptions)
      try {
        await use(context)
      } finally {
        await context.close()
      }
    } finally {
      await browser.close()
    }
  },
  page: async ({ context }, use) => {
    await use(await context.newPage())
  },
})

async function forwardThroughHistoryToLive(
  panel: Locator,
  maximumFrames = 256,
): Promise<void> {
  const status = panel.getByRole('status')
  const forward = panel.getByRole('button', { name: 'Forward', exact: true })
  for (let frame = 0; frame < maximumFrames; frame += 1) {
    if ((await status.textContent()) !== 'History') return
    await expect(forward).toBeEnabled()
    await forward.click()
  }
  throw new Error(`Recorded history did not rejoin live within ${maximumFrames} frames`)
}

test('proves security headers, nested execution, and exact source/action/world correlation', async ({
  page,
}) => {
  const diagnostics = observeBrowserDiagnostics(page)
  await expectSecurityHeaders(page)
  await expectPackedIDEReady(page)

  const sidebar = page.getByTestId('sidebar')
  await expect(sidebar.getByText('main.py', { exact: true })).toBeVisible()
  await expect(sidebar.getByText('karel.py', { exact: true })).toHaveCount(0)
  await expect(sidebar.getByText('karel_world.json', { exact: true })).toHaveCount(0)
  await expect(sidebar.getByText('karel_run.json', { exact: true })).toHaveCount(0)
  const persisted = await page.evaluate(() => {
    return window.__PACKED_KAREL__.persistedFiles('primary')
  })
  expect(Object.keys(persisted ?? {}).sort()).toEqual([
    '/workspace/main.py',
    '/workspace/student/__init__.py',
    '/workspace/student/route.py',
  ])

  const panel = await openKarelPanel(page)
  await expect(panel.getByRole('img', { name: /Nested Module World/u })).toBeVisible()
  await panel.getByRole('button', { name: 'Prepare', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Paused', { timeout: 150_000 })

  await expect(page.getByRole('tab', { name: /^main\.py/u })).toHaveAttribute(
    'aria-selected',
    'true',
  )
  await expect(page.getByRole('contentinfo', { name: 'Status bar' })).toContainText(
    'Ln 1, Col 1',
  )
  await expect(page.locator('.monaco-editor .source-presentation-current-line')).toHaveCount(1)

  await panel.getByRole('button', { name: 'Play', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Complete', {
    timeout: 150_000,
  })

  const events = await protocolEvents(page)
  expect(events).toHaveLength(7)
  expect(events.map(({ sequence }) => sequence)).toEqual([0, 1, 2, 3, 4, 5, 6])
  expect(new Set(events.map(({ runId }) => runId))).toEqual(
    new Set(['primary-run-1']),
  )
  const states = events.filter((event) => event.type === 'state')
  expect(states.map(({ action }) => action)).toEqual([
    'load',
    'move',
    'move',
    'turn_left',
    'move',
    'turn_right',
  ])
  expect(states[1]).toMatchObject({
    action: 'move',
    source: { path: 'student/route.py', line: 4 },
    world: { karel: { avenue: 2, street: 1, direction: 'east' } },
  })
  expect(states[4]).toMatchObject({
    action: 'move',
    source: { path: 'student/route.py', line: 7 },
    world: { karel: { avenue: 3, street: 2, direction: 'north' } },
  })
  expect(events.at(-1)).toMatchObject({
    type: 'terminal',
    outcome: 'completed',
    world: { karel: { avenue: 3, street: 2, direction: 'east' } },
  })
  await expect(panel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 3, street 2, facing east/u,
  )
  await expect(panel.getByTestId('karel-robot-icon')).toHaveAttribute(
    'href',
    /^data:image\/png;base64,/u,
  )
  await expect(panel.getByTestId('karel-robot')).toHaveAttribute(
    'transform',
    /rotate\(0\)/u,
  )
  await expect(page.locator('.xterm-rows')).toContainText('Program exited with code 0')

  const back = panel.getByRole('button', { name: 'Back', exact: true })
  await back.click()
  for (let frame = 0; frame < 32; frame += 1) {
    if ((await instanceSnapshot(page))?.editor.activeFile === '/workspace/student/route.py') {
      break
    }
    if (await back.isDisabled()) break
    await back.click()
  }
  await expect(panel.getByRole('status')).toHaveText('History')
  await expect(panel).toContainText(/Recorded frame \d+ of \d+/u)
  await expect.poll(async () => (await instanceSnapshot(page))?.editor.activeFile).toBe(
    '/workspace/student/route.py',
  )
  await expect(page.locator('.monaco-editor .source-presentation-historical-line')).toHaveCount(1)
  await forwardThroughHistoryToLive(panel)
  await expect(panel.getByRole('status')).toHaveText('Complete')

  await expect.poll(() => diagnostics.externalResponses.some(
    (response) => /monaco-editor@0\.56\.0\/min\/vs\/loader\.js/u.test(response.url()),
  )).toBe(true)
  await expect.poll(() => diagnostics.externalResponses.some(
    (response) => /debugger-sh@0\.3\.15\/dist\/engine_bg\.wasm/u.test(response.url()),
  )).toBe(true)
  await expect.poll(() => diagnostics.externalResponses.some(
    (response) => /^https:\/\/runno\.dev\//u.test(response.url()),
  )).toBe(true)
  for (const response of diagnostics.externalResponses) {
    expect(response.status(), response.url()).toBeLessThan(400)
    const headers = response.headers()
    expect(
      headers['access-control-allow-origin'] === '*'
      || headers['cross-origin-resource-policy'] === 'cross-origin',
      `cross-origin isolation header missing for ${response.url()}`,
    ).toBe(true)
  }

  await captureEvidence(page, '01-nested-source-correlation.png')
  expectCleanBrowser(diagnostics)
})

