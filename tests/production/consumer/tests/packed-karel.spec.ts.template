test('processes 2,000 valid actions and exposes bounded visible history', async ({
  page,
}) => {
  const diagnostics = observeBrowserDiagnostics(page)
  await gotoScenario(page, 'stress')
  const panel = await openKarelPanel(page)
  const startedAt = Date.now()
  await panel.getByRole('button', { name: 'Play', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Complete', {
    timeout: 90_000,
  })
  const elapsedMs = Date.now() - startedAt
  process.stdout.write(`Packed stress: 2000 actions completed in ${elapsedMs}ms\n`)

  const events = await protocolEvents(page)
  expect(events).toHaveLength(2_002)
  expect(events[0]).toMatchObject({ type: 'state', sequence: 0, action: 'load' })
  expect(events[1]).toMatchObject({
    type: 'state',
    sequence: 1,
    action: 'turn_left',
    source: { path: 'main.py', line: 4 },
  })
  expect(events.at(-2)).toMatchObject({
    type: 'state',
    sequence: 2_000,
    action: 'turn_left',
    world: { karel: { direction: 'east' } },
  })
  expect(events.at(-1)).toMatchObject({
    type: 'terminal',
    sequence: 2_001,
    outcome: 'completed',
  })
  expect(events.every((event, index) => event.sequence === index)).toBe(true)
  await expect(panel).toContainText('Live frame 10 of 10')
  await expect(panel).toContainText(/older frames discarded/u)

  await panel.getByRole('button', { name: 'Back', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('History')
  await expect(panel).toContainText(/Recorded frame \d+ of 10/u)
  await forwardThroughHistoryToLive(panel)
  await expect(panel.getByRole('status')).toHaveText('Complete')
  await captureEvidence(page, '04-protocol-stress-truncated-history.png')
  expectCleanBrowser(diagnostics)
})

test('preserves ordinary stdout and reports a typed nested exception source', async ({
  page,
}) => {
  // The Karel-optimized 85/15 split intentionally gives the terminal a compact
  // viewport. Use a normal laptop-height host so both the typed error and final
  // process status remain visible without reaching into terminal internals.
  await page.setViewportSize({ width: 800, height: 900 })
  const diagnostics = observeBrowserDiagnostics(page)
  await gotoScenario(page, 'exception')
  const panel = await openKarelPanel(page)
  await panel.getByRole('button', { name: 'Play', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Error', {
    timeout: 150_000,
  })
  await expect(panel.getByRole('alert')).toContainText('synthetic nested failure')
  const terminal = page.locator('.xterm-rows')
  const exceptionProbe = await instanceProbe(page)
  expect(exceptionProbe?.stdoutSample).toContain(
    'ordinary stdout before typed nested failure',
  )
  expect(exceptionProbe?.stdoutSample).toContain(
    'nested ordinary stdout remains visible',
  )
  await page.getByRole('textbox', { name: 'Terminal input' }).focus()
  await page.keyboard.press('Shift+PageUp')
  await expect(terminal).toContainText('SyntheticNestedError: synthetic nested failure')

  const events = await protocolEvents(page)
  expect(events.at(-1)).toMatchObject({
    type: 'terminal',
    outcome: 'runtime-error',
    message: 'synthetic nested failure',
    errorType: 'SyntheticNestedError',
    source: { path: 'failures/nested.py', line: 6 },
  })
  await expect.poll(async () => (await instanceSnapshot(page))?.editor.activeFile).toBe(
    '/workspace/failures/nested.py',
  )
  await captureEvidence(page, '05-typed-nested-exception.png')
  expectCleanBrowser(diagnostics)
})

test('aborts an active debug run and completes a clean correlated rerun', async ({
  page,
}) => {
  const diagnostics = observeBrowserDiagnostics(page)
  await gotoScenario(page, 'abort')
  const panel = await openKarelPanel(page)
  await panel.getByRole('button', { name: 'Prepare', exact: true }).click()
  // Require both the correlated host pause and its visible live frame before
  // Reset so this scenario exercises an active debug run deterministically.
  await expect.poll(async () => {
    return (await hostEvents(page)).filter(({ type }) => type === 'debug_paused').length
  }, { timeout: 150_000 }).toBe(1)
  await expect(panel.getByRole('status')).toHaveText('Paused', { timeout: 150_000 })
  await expect(panel).toContainText('Live frame 1 of 1')
  await panel.getByRole('button', { name: 'Reset', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Ready', { timeout: 150_000 })
  await expect(panel).toContainText('No recorded frames')
  await expect.poll(async () => {
    return (await hostEvents(page)).filter(({ type }) => type === 'program_exit').length
  }, { timeout: 150_000 }).toBe(1)

  const play = panel.getByRole('button', { name: 'Play', exact: true })
  await expect(play).toBeEnabled()
  await play.click()
  await expect(panel.getByRole('status')).toHaveText('Complete', {
    timeout: 150_000,
  })
  const events = await protocolEvents(page)
  const abortedRunEvents = events.filter(({ runId }) => runId === 'primary-run-1')
  expect(abortedRunEvents.some(({ type }) => type === 'terminal')).toBe(false)
  const rerunEvents = events.filter(({ runId }) => runId === 'primary-run-2')
  expect(rerunEvents).toHaveLength(26)
  expect(rerunEvents.at(-1)).toMatchObject({
    type: 'terminal',
    outcome: 'completed',
    world: { karel: { avenue: 1, street: 1, direction: 'east' } },
  })
  await expect(page.locator('.xterm-rows')).toContainText('Program exited with code 0')
  await captureEvidence(page, '06-abort-clean-rerun.png')
  expectCleanBrowser(diagnostics)
})

test('remounts sequential workspaces without files, state, or listeners crossing projects', async ({
  page,
}) => {
  const diagnostics = observeBrowserDiagnostics(page)
  await page.goto('/nested/production/matrix/route?mode=sequential')
  const first = page.locator('[data-instance-id="sequential-project-a"]')
  await expectPackedIDEReady(page, first)
  const firstPanel = await openKarelPanel(first)
  await runKarel(first, firstPanel)
  await expect(firstPanel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 2, street 1, facing east/u,
  )
  expect(await page.evaluate(() => Object.keys(
    window.__PACKED_KAREL__.persistedFiles('sequential-project-a') ?? {},
  ).sort())).toEqual(['/workspace/a_only.py', '/workspace/main.py'])

  await page.evaluate(() => window.__PACKED_KAREL__.close('sequential-project-a'))
  await page.getByRole('button', { name: 'Unmount project' }).click()
  await expect(page.getByText('Project unmounted', { exact: true })).toBeVisible()
  await expect.poll(async () => {
    return (await instanceProbe(page, 'sequential-project-a'))?.activeRuntimeSubscriptions
  }).toBe(0)
  await expect.poll(async () => {
    const probe = await instanceProbe(page, 'sequential-project-a')
    return probe?.runtimeSessionsDisposed === probe?.runtimeSessionsCreated
  }).toBe(true)

  await page.getByRole('button', { name: 'Mount project B' }).click()
  const second = page.locator('[data-instance-id="sequential-project-b"]')
  await expectPackedIDEReady(page, second)
  const sidebar = second.getByTestId('sidebar')
  await expect(sidebar.getByText('b_only.py', { exact: true })).toBeVisible()
  await expect(sidebar.getByText('a_only.py', { exact: true })).toHaveCount(0)
  const secondPanel = await openKarelPanel(second)
  await expect(secondPanel.getByRole('status')).toHaveText('Ready')
  await runKarel(second, secondPanel)
  await expect(secondPanel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 1, street 1, facing north/u,
  )
  expect(await page.evaluate(() => Object.keys(
    window.__PACKED_KAREL__.persistedFiles('sequential-project-b') ?? {},
  ).sort())).toEqual(['/workspace/b_only.py', '/workspace/main.py'])
  await captureEvidence(page, '07-sequential-project-remount.png')

  await page.evaluate(() => window.__PACKED_KAREL__.close('sequential-project-b'))
  await page.getByRole('button', { name: 'Unmount project' }).click()
  await expect.poll(async () => {
    return (await instanceProbe(page, 'sequential-project-b'))?.activeRuntimeSubscriptions
  }).toBe(0)
  expectCleanBrowser(diagnostics)
})

test('runs two simultaneous isolated IDE realms with overlapping local run identities', async ({
  page,
  context,
}) => {
  const secondPage = await context.newPage()
  const firstDiagnostics = observeBrowserDiagnostics(page)
  const secondDiagnostics = observeBrowserDiagnostics(secondPage)
  await Promise.all([
    gotoScenario(page, 'project-a'),
    gotoScenario(secondPage, 'project-b'),
  ])
  const [firstPanel, secondPanel] = await Promise.all([
    openKarelPanel(page),
    openKarelPanel(secondPage),
  ])
  await Promise.all([
    runKarel(page, firstPanel),
    runKarel(secondPage, secondPanel),
  ])
  await expect(firstPanel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 2, street 1, facing east/u,
  )
  await expect(secondPanel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 1, street 1, facing north/u,
  )

  const [firstEvents, secondEvents] = await Promise.all([
    protocolEvents(page),
    protocolEvents(secondPage),
  ])
  expect(firstEvents.at(-1)).toMatchObject({
    runId: 'primary-run-1',
    type: 'terminal',
    outcome: 'completed',
    world: { karel: { avenue: 2, direction: 'east' } },
  })
  expect(secondEvents.at(-1)).toMatchObject({
    runId: 'primary-run-1',
    type: 'terminal',
    outcome: 'completed',
    world: { karel: { avenue: 1, direction: 'north' } },
  })
  expect(Object.keys((await page.evaluate(
    () => window.__PACKED_KAREL__.persistedFiles('primary'),
  )) ?? {})).toContain('/workspace/a_only.py')
  expect(Object.keys((await secondPage.evaluate(
    () => window.__PACKED_KAREL__.persistedFiles('primary'),
  )) ?? {})).toContain('/workspace/b_only.py')
  await captureEvidence(page, '08-isolated-realm-project-a.png')
  await captureEvidence(secondPage, '09-isolated-realm-project-b.png')
  expectCleanBrowser(firstDiagnostics)
  expectCleanBrowser(secondDiagnostics)

  await secondPage.close()
  await expect(firstPanel.getByRole('status')).toHaveText('Complete')
})

test('unmounts an active IDE with exact listener, session, persistence, and worker cleanup', async ({
  page,
}) => {
  await page.addInitScript(() => {
    const NativeWorker = window.Worker
    const state = { created: 0, active: 0, terminated: 0 }
    Object.defineProperty(window, '__PACKED_WORKERS__', { value: state })
    class TrackedWorker extends NativeWorker {
      private packedTerminated = false

      constructor(url: string | URL, options?: WorkerOptions) {
        super(url, options)
        state.created += 1
        state.active += 1
      }

      override terminate() {
        if (!this.packedTerminated) {
          this.packedTerminated = true
          state.active -= 1
          state.terminated += 1
        }
        super.terminate()
      }
    }
    Object.defineProperty(window, 'Worker', { value: TrackedWorker })
  })
  const diagnostics = observeBrowserDiagnostics(page)
  await page.goto('/nested/production/matrix/route?mode=lifecycle')
  await expect(page.getByText('Lifecycle IDE unmounted')).toBeVisible()
  await page.getByRole('button', { name: 'Mount lifecycle IDE', exact: true }).click()
  const scope = page.locator('[data-instance-id="lifecycle"]')
  await expectPackedIDEReady(page, scope)
  const panel = await openKarelPanel(scope)
  await panel.getByRole('button', { name: 'Prepare', exact: true }).click()
  await expect(panel.getByRole('status')).toHaveText('Paused', { timeout: 150_000 })
  const before = await instanceProbe(page, 'lifecycle')
  expect(before?.activeRuntimeSubscriptions).toBeGreaterThan(0)
  await expect.poll(() => page.evaluate(() => {
    return (window as unknown as {
      __PACKED_WORKERS__: { created: number }
    }).__PACKED_WORKERS__.created
  })).toBeGreaterThan(0)
  await captureEvidence(page, '10-lifecycle-paused-before-cleanup.png')

  await page.evaluate(() => window.__PACKED_KAREL__.close('lifecycle'))
  await page.getByRole('button', { name: 'Unmount lifecycle IDE' }).click()
  await expect(page.getByText('Lifecycle IDE unmounted')).toBeVisible()
  await expect.poll(async () => {
    return (await instanceProbe(page, 'lifecycle'))?.activeRuntimeSubscriptions
  }).toBe(0)
  await expect.poll(async () => {
    const probe = await instanceProbe(page, 'lifecycle')
    return probe?.activations === probe?.deactivations
  }).toBe(true)
  await expect.poll(async () => {
    const probe = await instanceProbe(page, 'lifecycle')
    return probe?.runtimeSessionsCreated === probe?.runtimeSessionsDisposed
  }).toBe(true)
  await expect.poll(() => page.evaluate(() => {
    return (window as unknown as {
      __PACKED_WORKERS__: { active: number }
    }).__PACKED_WORKERS__.active
  })).toBe(0)
  const eventCount = (await hostEvents(page, 'lifecycle')).length
  await page.waitForTimeout(500)
  expect((await hostEvents(page, 'lifecycle')).length).toBe(eventCount)
  const after = await instanceProbe(page, 'lifecycle')
  expect(after?.persistenceEvents).toContain('flush')
  expect(after?.persistenceEvents).toContain('dispose')
  await captureEvidence(page, '11-lifecycle-unmounted-clean.png')
  expectCleanBrowser(diagnostics)
})

test('meets keyboard, focus, reduced-motion, responsive, theme, contrast, and non-color status checks', async ({
