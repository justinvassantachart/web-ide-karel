  await page.setViewportSize({ width: 640, height: 820 })
  const diagnostics = observeBrowserDiagnostics(page)
  await gotoScenario(page, 'nested')

  const karelTab = page.getByRole('tab', { name: 'Karel', exact: true })
  await expect(karelTab).toHaveAttribute('aria-selected', 'true')
  await karelTab.focus()
  await expect(karelTab).toBeFocused()
  const panel = page.getByRole('region', { name: 'Karel world and playback' })
  await expect(panel).toBeVisible()
  await expect(panel.getByRole('status')).toHaveAttribute('aria-live', 'polite')
  await expect(panel.getByRole('group', { name: 'Run controls' })).toBeVisible()
  await expect(panel.getByRole('group', { name: 'Recorded history controls' })).toBeVisible()
  await expect(panel.getByTestId('karel-robot-icon')).toBeVisible()
  await expect(panel.locator('.karel-panel-header')).toHaveCount(0)
