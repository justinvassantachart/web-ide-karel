  const playbackControls = panel.locator('.karel-playback-controls')
  expect(await playbackControls.evaluate(
    (element) => getComputedStyle(element).display,
  )).toBe('flex')
  const speed = panel.getByRole('slider', { name: 'Playback speed' })
  await expect(speed).toHaveAttribute(
    'aria-valuetext',
    /^(?:Slow|Normal|Fast), \d+ milliseconds between steps$/u,
  )
  const responsiveLayout = await panel.evaluate((element) => {
    const controls = element.querySelector<HTMLElement>('.karel-playback-controls')
    const settings = element.querySelector<HTMLElement>('.karel-control-settings')
    const worldViewport = element.querySelector<HTMLElement>('.karel-world-viewport')
    if (!controls || !settings || !worldViewport) {
      throw new Error('Karel responsive layout is incomplete')
    }
    return {
      panelClientWidth: element.clientWidth,
      panelScrollWidth: element.scrollWidth,
      controlsWrap: getComputedStyle(controls).flexWrap,
      controlsOverflowX: getComputedStyle(controls).overflowX,
      controlsClientWidth: controls.clientWidth,
      controlsScrollWidth: controls.scrollWidth,
      settingsClientWidth: settings.clientWidth,
      settingsScrollWidth: settings.scrollWidth,
      buttonWhiteSpace: [...controls.querySelectorAll<HTMLElement>('.karel-control-button')]
        .map((button) => getComputedStyle(button).whiteSpace),
      fieldDirections: [...settings.querySelectorAll<HTMLElement>('.karel-control-field')]
        .map((field) => getComputedStyle(field).flexDirection),
      worldWidth: worldViewport.getBoundingClientRect().width,
      worldHeight: worldViewport.getBoundingClientRect().height,
    }
  })
  expect(responsiveLayout.panelClientWidth).toBeGreaterThan(0)
  expect(responsiveLayout.panelScrollWidth).toBeLessThanOrEqual(
    responsiveLayout.panelClientWidth,
  )
  expect(responsiveLayout.controlsWrap).toBe('nowrap')
  expect(responsiveLayout.controlsOverflowX).toBe('auto')
  expect(responsiveLayout.controlsClientWidth).toBeLessThanOrEqual(
    responsiveLayout.panelClientWidth,
  )
  expect(responsiveLayout.controlsScrollWidth).toBeGreaterThanOrEqual(
    responsiveLayout.controlsClientWidth,
  )
  expect(responsiveLayout.settingsScrollWidth).toBeLessThanOrEqual(
    responsiveLayout.settingsClientWidth,
  )
  expect(responsiveLayout.buttonWhiteSpace.every(
    (value) => value === 'nowrap',
  )).toBe(true)
  expect(responsiveLayout.fieldDirections.every(
    (value) => value === 'row',
  )).toBe(true)
  expect(responsiveLayout.worldWidth).toBeCloseTo(
    responsiveLayout.panelClientWidth,
    0,
  )
  expect(responsiveLayout.worldHeight).toBeGreaterThanOrEqual(150)
  await expect(panel.getByText('Speed', { exact: true })).toBeVisible()
  await expect(panel.getByText('World', { exact: true })).toBeVisible()
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true)

  const speedValue = panel.locator('.karel-speed-value')
  await expect(speedValue).toBeVisible()
  expect(await contrastRatio(speedValue, playbackControls)).toBeGreaterThanOrEqual(4.5)
  expect(await page.evaluate(() => document.documentElement.dataset.theme)).toBe('light')
  const lightPalette = await panel.evaluate((element) => {
    const style = getComputedStyle(element)
    return { color: style.color, background: style.backgroundColor }
  })
  await captureEvidence(page, '12-accessibility-light-responsive.png')

  await page.getByRole('button', { name: 'Manage' }).click()
  await page.getByRole('menuitemradio', { name: 'Dark (Modern)' }).click()
  await expect.poll(() => page.evaluate(
    () => document.documentElement.dataset.theme,
  )).toBe('dark')
  expect(await contrastRatio(speedValue, playbackControls)).toBeGreaterThanOrEqual(4.5)
  const darkPalette = await panel.evaluate((element) => {
    const style = getComputedStyle(element)
    return { color: style.color, background: style.backgroundColor }
  })
  expect(darkPalette.color).not.toBe(lightPalette.color)
  expect(darkPalette.background).not.toBe(lightPalette.background)

  const run = page.getByRole('button', { name: 'Run Karel', exact: true })
  await run.focus()
  await page.keyboard.press('Enter')
  await expect(panel.getByRole('status')).toHaveText('Complete', {
    timeout: 150_000,
  })
  await expect(panel.getByRole('status')).toHaveText('Complete')
  await expect(panel.getByRole('img')).toHaveAttribute(
    'aria-label',
    /avenue 3, street 2, facing east/u,
  )
  await captureEvidence(page, '13-accessibility-dark-complete.png')
  expectCleanBrowser(diagnostics)
})
